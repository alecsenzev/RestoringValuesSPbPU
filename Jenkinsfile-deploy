stage('Fetch artifacts from L2') {
  steps {
    script {
      sh 'rm -rf deploy_art && mkdir -p deploy_art'

      // Копируем wheel
      step([
        $class: 'CopyArtifact',
        projectName: params.BUILD_JOB,
        selector: [$class: 'StatusBuildSelector', stable: false],
        filter: 'dist/*.whl',
        target: 'deploy_art',
        fingerprintArtifacts: true
      ])

      // Копируем архив с приложением
      step([
        $class: 'CopyArtifact',
        projectName: params.BUILD_JOB,
        selector: [$class: 'StatusBuildSelector', stable: false],
        filter: 'app-restoringvalues.tgz',
        target: 'deploy_art',
        fingerprintArtifacts: true
      ])

      // Копируем логи/CSV (опционально)
      step([
        $class: 'CopyArtifact',
        projectName: params.BUILD_JOB,
        selector: [$class: 'StatusBuildSelector', stable: false],
        filter: 'artifacts.tgz',
        target: 'deploy_art',
        fingerprintArtifacts: true
      ])

      sh 'find deploy_art -maxdepth 4 -type f -print'
    }
  }
}
